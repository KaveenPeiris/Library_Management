<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="450.0" prefWidth="400.0" spacing="15.0" style="-fx-background-color: #3d314a;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.LoginPageController">
    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
    </padding>
    <children>
        <Label text="Library System" textFill="WHITE">
            <font>
                <Font name="System Bold" size="26.0" />
            </font>
        </Label>
        <Label text="Please Login to Continue" textFill="#e0d68a">
            <font>
                <Font size="14.0" />
            </font>
            <VBox.margin>
                <Insets bottom="10.0" />
            </VBox.margin>
        </Label>

        <TextField fx:id="txtUsername" promptText="Username" style="-fx-pref-height: 35;" />
        <PasswordField fx:id="txtPassword" promptText="Password" style="-fx-pref-height: 35;" />

        <Button fx:id="btnLogin" maxWidth="1.7976931348623157E308" onAction="#btnLoginOnAction" style="-fx-background-color: #2a9d8f; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-height: 35;" text="Login" />
        <Button fx:id="btnClear" maxWidth="1.7976931348623157E308" onAction="#btnClearOnAction" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-pref-height: 35;" text="Clear" />
    </children>
</VBox>