<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="650.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.IssueBookController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #3d314a;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <children>
                <Button fx:id="btnBack" onAction="#btnBackOnAction" style="-fx-background-color: #685044; -fx-text-fill: white;" text="&lt; Back" />
                <Label text="Issue Book Management" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>
            </children>
        </HBox>
    </top>
    <center>
        <VBox spacing="20.0" style="-fx-background-color: #fff3b0;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <!-- Form Inputs -->
                <GridPane hgap="15.0" vgap="15.0">
                    <children>
                        <Label text="Issue ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <TextField fx:id="txtIssueId" promptText="ISS001" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <Label text="Member ID:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                        <TextField fx:id="txtMemberId" promptText="M001" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                        <Label text="Book ID:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <TextField fx:id="txtBookId" promptText="B001" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label text="Issue Date:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                        <DatePicker fx:id="dpIssueDate" maxWidth="1.7976931348623157E308" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                        <Label text="Due Date:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <DatePicker fx:id="dpDueDate" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                    </children>
                </GridPane>

                <!-- Action Buttons -->
                <HBox spacing="10.0">
                    <children>
                        <Button fx:id="btnIssueBook" onAction="#btnIssueBookOnAction" style="-fx-background-color: #2a9d8f; -fx-text-fill: white; -fx-font-weight: bold;" text="Issue Book" />
                        <Button fx:id="btnClear" onAction="#btnClearOnAction" style="-fx-background-color: #e76f51; -fx-text-fill: white;" text="Clear" />
                    </children>
                </HBox>

                <!-- Issued Books Table -->
                <TableView fx:id="tblIssuedBooks" prefHeight="350.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colIssueId" prefWidth="120.0" text="Issue ID" />
                        <TableColumn fx:id="colMemberId" prefWidth="150.0" text="Member ID" />
                        <TableColumn fx:id="colBookId" prefWidth="150.0" text="Book ID" />
                        <TableColumn fx:id="colIssueDate" prefWidth="180.0" text="Issue Date" />
                        <TableColumn fx:id="colDueDate" prefWidth="180.0" text="Due Date" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </center>
</BorderPane>