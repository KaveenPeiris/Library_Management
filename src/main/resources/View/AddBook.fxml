<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="650.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.AddBookController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #3d314a;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <children>
                <Button fx:id="btnBack" onAction="#btnBackOnAction" style="-fx-background-color: #685044; -fx-text-fill: white;" text="&lt; Back" />
                <Label text="Book Management" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>
            </children>
        </HBox>
    </top>
    <center>
        <VBox spacing="20.0" style="-fx-background-color: #fff3b0;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <!-- Form Inputs -->
                <GridPane hgap="15.0" vgap="15.0">
                    <children>
                        <Label text="Book ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <TextField fx:id="txtId" promptText="B001" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <Label text="Title:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                        <TextField fx:id="txtTitle" promptText="Madol Doova" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                        <Label text="Author:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <TextField fx:id="txtAuthor" promptText="Martin Wickramasinghe" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label text="Category:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                        <TextField fx:id="txtCategory" promptText="Novel" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                        <Label text="Quantity:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <TextField fx:id="txtQty" promptText="10" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                    </children>
                </GridPane>

                <!-- Action Buttons -->
                <HBox spacing="10.0">
                    <children>
                        <Button fx:id="btnAdd" onAction="#btnAddOnAction" style="-fx-background-color: #2a9d8f; -fx-text-fill: white; -fx-font-weight: bold;" text="Add Book" />
                        <Button fx:id="btnUpdate" onAction="#btnUpdateOnAction" style="-fx-background-color: #f4a261; -fx-text-fill: white; -fx-font-weight: bold;" text="Update" />
                        <Button fx:id="btnDelete" onAction="#btnDeleteOnAction" style="-fx-background-color: #e63946; -fx-text-fill: white; -fx-font-weight: bold;" text="Delete" />
                        <Button fx:id="btnClear" onAction="#btnClearOnAction" style="-fx-background-color: #6c757d; -fx-text-fill: white;" text="Clear" />
                    </children>
                </HBox>

                <!-- Books Table -->
                <TableView fx:id="tblBooks" prefHeight="350.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="120.0" text="Book ID" />
                        <TableColumn fx:id="colTitle" prefWidth="220.0" text="Title" />
                        <TableColumn fx:id="colAuthor" prefWidth="200.0" text="Author" />
                        <TableColumn fx:id="colCategory" prefWidth="160.0" text="Category" />
                        <TableColumn fx:id="colQty" prefWidth="100.0" text="Qty" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </center>
</BorderPane>