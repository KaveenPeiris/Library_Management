<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="800.0" spacing="15.0" style="-fx-background-color: #fff3b0;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.ManageMembersController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label text="Manage Members" textFill="#3d314a">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>
        <HBox spacing="10.0">
            <children>
                <TextField fx:id="txtSearch" promptText="Search Member..." HBox.hgrow="ALWAYS" />
                <Button fx:id="btnSearch" onAction="#btnSearchOnAction" style="-fx-background-color: #2a9d8f; -fx-text-fill: white;" text="Search" />
            </children>
        </HBox>
        <TableView fx:id="tblMembers" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" prefWidth="100.0" text="Member ID" />
                <TableColumn fx:id="colName" prefWidth="180.0" text="Full Name" />
                <TableColumn fx:id="colEmail" prefWidth="180.0" text="Email" />
                <TableColumn fx:id="colPhone" prefWidth="120.0" text="Phone" />
                <TableColumn fx:id="colAddress" prefWidth="180.0" text="Address" />
            </columns>
        </TableView>
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button fx:id="btnEdit" onAction="#btnEditOnAction" style="-fx-background-color: #e76f51; -fx-text-fill: white;" text="Edit Member" />
                <Button fx:id="btnDelete" onAction="#btnDeleteOnAction" style="-fx-background-color: #d62828; -fx-text-fill: white;" text="Delete Member" />
            </children>
        </HBox>
    </children>
</VBox>